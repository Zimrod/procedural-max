{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": false,
    "sourceMap": true
  },

  "include": [
    "src/server.ts",
    "src/routes/**/*.ts",
    "src/services/**/*.ts",
    "src/lib/**/*.ts",

    "src/core/planning/**/*.ts",
    "src/core/segmentation/**/*.ts",
    "src/core/narrative/**/*.ts",
    "src/core/taxonomy/**/*.ts",
    "src/core/inference/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}